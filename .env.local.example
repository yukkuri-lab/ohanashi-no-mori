# 必須環境変数の一覧
# このファイルをコピーして .env.local にリネームし、値を入力してください
# .env.local は .gitignore に入っているので GitHub には上がりません

# Google Cloud Text-to-Speech API キー（必須）
# 取得方法: https://console.cloud.google.com/ → API と サービス → 認証情報
# ★ 取得したキーには必ず「HTTPリファラ制限」と「割当上限」をかけてください。
#   手順は README-運用メモ.md に書いてあります（いちばん大事な防御です）
GOOGLE_TTS_API_KEY=ここにAPIキーを貼り付ける

# 音声APIを呼び出せるドメイン（本番URLに変更する）
# カンマ区切りで複数書けます。前後の空白は無視されます。
# 例: ALLOWED_ORIGIN=https://ohanashi-no-mori.vercel.app,https://ohanashinomori.com
#
# 注意: ここに書いたドメインと「完全一致」したものだけを通します。
#       以前は「.vercel.app で終われば通す」という設定でしたが、
#       それだと他人がVercelに置いたサイトからも呼べてしまうため、やめました。
ALLOWED_ORIGIN=http://localhost:3000
